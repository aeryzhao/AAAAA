/* pages/detail/detail.wxss */
.page {
  padding-bottom: 40rpx;
}

/* 头部 */
.header-bg {
  position: relative;
  background: linear-gradient(135deg, #0e504b, #204f3c);
  padding: 80rpx 32rpx 60rpx;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 50%, rgba(15,118,110,.3), transparent 70%);
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-year {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: var(--accent);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 6rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 20rpx;
  line-height: 1.3;
}

.header-tags {
  display: flex;
  gap: 12rpx;
}

.header-tags .tag {
  background: rgba(255,255,255,.2);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,.3);
}

/* 区块 */
.section {
  margin: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: var(--shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}

.desc-text {
  font-size: 28rpx;
  color: var(--text-light);
  line-height: 1.8;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.info-label {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 600;
}

.info-value {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

/* 操作按钮 */
.actions {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--surface);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid var(--primary);
  border-radius: 12rpx;
}
