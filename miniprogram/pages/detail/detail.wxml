<!--pages/detail/detail.wxml-->
<view class="page" wx:if="{{spot}}">
  <!-- 头部 -->
  <view class="header">
    <view class="header-bg">
      <view class="header-overlay"></view>
      <view class="header-content">
        <view class="header-year">{{spot.year}}年入选</view>
        <view class="header-title">{{spot.name}}</view>
        <view class="header-tags">
          <text class="tag tag-province">{{spot.province}}</text>
          <text class="tag tag-category">{{spot.category}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 描述 -->
  <view class="section">
    <view class="section-title">景区简介</view>
    <view class="desc-text">{{spot.desc}}</view>
  </view>

  <!-- 详细信息 -->
  <view class="section">
    <view class="section-title">详细信息</view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">省份</text>
        <text class="info-value">{{spot.province}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">城市</text>
        <text class="info-value">{{spot.city}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">类别</text>
        <text class="info-value">{{spot.category}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">入选年份</text>
        <text class="info-value">{{spot.year}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">级别</text>
        <text class="info-value">AAAAA</text>
      </view>
      <view class="info-item" wx:if="{{coord}}">
        <text class="info-label">坐标</text>
        <text class="info-value">{{coord.lat}}, {{coord.lng}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="btn-primary" bindtap="openBaike">
      <text>📖 查看参考链接</text>
    </view>
    <view class="action-row">
      <button class="btn-secondary btn-share" open-type="share">分享景区</button>
      <view class="btn-secondary btn-map" bindtap="openMap">
        <text>🗺️ 在地图中查看</text>
      </view>
    </view>
  </view>
</view>
