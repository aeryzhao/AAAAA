/* pages/map/map.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 筛选栏 */
.map-filters {
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

.filter-scroll {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.filter-item {
  flex: 1;
  min-width: 0;
}

.filter-item.picker-btn {
  flex: none;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  padding: 0 16rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.picker-btn.active {
  color: var(--primary);
  border-color: var(--primary);
  background: rgba(15, 118, 110, .05);
}

.picker-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.fit-btn {
  flex: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 8rpx;
  white-space: nowrap;
}

.filter-stats {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

.stats-num {
  color: var(--primary);
  font-weight: 700;
}

/* 地图 */
.scenic-map {
  flex: 1;
  width: 100%;
}
