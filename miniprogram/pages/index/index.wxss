/* pages/index/index.wxss */
.page {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 80rpx;
}

.search-clear {
  font-size: 28rpx;
  color: var(--muted);
  padding: 10rpx;
}

/* 筛选器 */
.filters {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}

.filter-item {
  flex: 1;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68rpx;
  padding: 0 16rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.picker-btn.active {
  color: var(--primary);
  border-color: var(--primary);
  background: rgba(15, 118, 110, .05);
}

.picker-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
}

/* 统计信息 */
.stats {
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--muted);
}

.stats-num {
  color: var(--primary);
  font-weight: 700;
}

.stats-hint {
  font-size: 22rpx;
  color: var(--accent);
}

/* 景区列表 */
.list {
  padding: 0 24rpx;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  position: relative;
}

.card-year {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 0 16rpx 0 12rpx;
}

.card-body {
  padding: 24rpx 24rpx 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
  padding-right: 140rpx;
}

.card-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.card-desc {
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--border);
  background: var(--surface-soft);
}

.card-location {
  font-size: 24rpx;
  color: var(--muted);
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.btn-action {
  font-size: 24rpx;
  color: var(--primary);
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--primary);
  border-radius: 8rpx;
  background: rgba(15, 118, 110, .05);
}

/* 分页 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
}

.page-btn {
  padding: 12rpx 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--primary);
}

.page-btn.disabled {
  color: var(--muted);
  background: var(--surface-soft);
  border-color: var(--border);
}

.page-info {
  font-size: 26rpx;
  color: var(--text-light);
}
